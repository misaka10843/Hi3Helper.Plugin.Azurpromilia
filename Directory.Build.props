<Project>

  <!--
    ============================================================================
    Directory.Build.props
    ============================================================================
    This file is INERT by default: with no extra properties passed on the command
    line it adds nothing to the build, so a normal `dotnet build` / `dotnet publish`
    behaves exactly as if this file did not exist.

    It exists to support an offline / sandboxed build path used on machines where
    NuGet restore cannot run (for example a locked-down environment where the
    Windows shell folder APIs that NuGet's `XPlatMachineWideSetting` depends on
    are unavailable, producing:

        error : Value cannot be null. (Parameter 'path1')
        at NuGet.Configuration.XPlatMachineWideSetting..ctor()

    To use it, build with:

        dotnet build <project> -c Release \
            -p:LocalNoNuGetBuild=true \
            -p:RestoreProjectStyle=Unknown \
            -p:SkipResolvePackageAssets=true \
            -p:GenerateDependencyFile=false

    (`build-local.sh` at the repository root wraps exactly this invocation.)

    Because `SkipResolvePackageAssets` bypasses NuGet's assets file entirely,
    `PackageReference` items are NOT resolved. The only package the plugin tree
    needs is `Microsoft.Extensions.Logging.Abstractions`, which is satisfied here
    by referencing the assembly straight out of the NuGet global-packages cache
    (or, failing that, out of the installed ASP.NET Core ref pack).

    This reference is compile-time only (`Private=false`): the plugin runs hosted
    inside Collapse Launcher, which already supplies that assembly at runtime.
    ============================================================================
  -->

  <PropertyGroup>
    <LocalNoNuGetBuild Condition="'$(LocalNoNuGetBuild)' == ''">false</LocalNoNuGetBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LocalNoNuGetBuild)' == 'true'">
    <_LoggingAbstractionsCachedPath>$(UserProfile)\.nuget\packages\microsoft.extensions.logging.abstractions\10.0.12\lib\net10.0\Microsoft.Extensions.Logging.Abstractions.dll</_LoggingAbstractionsCachedPath>
    <_LoggingAbstractionsRefPackPath>$(UserProfile)\.dotnet\packs\Microsoft.AspNetCore.App.Ref\10.0.12\ref\net10.0\Microsoft.Extensions.Logging.Abstractions.dll</_LoggingAbstractionsRefPackPath>
    <_LoggingAbstractionsSharedPath>$(UserProfile)\.dotnet\shared\Microsoft.AspNetCore.App\10.0.12\Microsoft.Extensions.Logging.Abstractions.dll</_LoggingAbstractionsSharedPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LocalNoNuGetBuild)' == 'true' AND Exists('$(_LoggingAbstractionsCachedPath)')">
    <_LoggingAbstractionsResolvedPath>$(_LoggingAbstractionsCachedPath)</_LoggingAbstractionsResolvedPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LocalNoNuGetBuild)' == 'true' AND '$(_LoggingAbstractionsResolvedPath)' == '' AND Exists('$(_LoggingAbstractionsRefPackPath)')">
    <_LoggingAbstractionsResolvedPath>$(_LoggingAbstractionsRefPackPath)</_LoggingAbstractionsResolvedPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LocalNoNuGetBuild)' == 'true' AND '$(_LoggingAbstractionsResolvedPath)' == '' AND Exists('$(_LoggingAbstractionsSharedPath)')">
    <_LoggingAbstractionsResolvedPath>$(_LoggingAbstractionsSharedPath)</_LoggingAbstractionsResolvedPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(LocalNoNuGetBuild)' == 'true' AND '$(_LoggingAbstractionsResolvedPath)' != ''">
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(_LoggingAbstractionsResolvedPath)</HintPath>
      <Private>false</Private>
      <NuGetPackageId>Microsoft.Extensions.Logging.Abstractions</NuGetPackageId>
      <NuGetPackageVersion>10.0.12</NuGetPackageVersion>
    </Reference>
  </ItemGroup>

</Project>
