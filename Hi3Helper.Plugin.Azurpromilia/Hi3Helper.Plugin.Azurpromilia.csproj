<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <LangVersion>preview</LangVersion>
    <AssemblyName>AzurPromilia</AssemblyName>
    <RootNamespace>Hi3Helper.Plugin.AzurPromilia</RootNamespace>
    <ProductName>Azur Promilia Plugin</ProductName>
    <Product>Collapse</Product>
    <Description>This library is a plugin for adding support for the game "Azur Promilia" into Collapse Launcher</Description>
    <AssemblyTitle>Azur Promilia Plugin</AssemblyTitle>
    <Company>AzurPromiliaPluginContributors</Company>
    <Authors>$(Company).</Authors>
    <Copyright>Copyright 2026 $(Company)</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Configurations>Debug;Release;DebugNoReflection;ReleaseNoReflection</Configurations>
    <Title>Hi3Helper.Plugin.Azurpromilia</Title>
    <NoWarn>$(NoWarn);CA2256</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='DebugNoReflection'">
    <DefineConstants>$(DefineConstants);DEBUG;USELIGHTWEIGHTJSONPARSER;MANUALCOM</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseNoReflection'">
    <DefineConstants>$(DefineConstants);USELIGHTWEIGHTJSONPARSER;MANUALCOM</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.png" LogicalName="AzurPromilia.Icon.png"/>
    <ProjectReference Include="..\Hi3Helper.Plugin.Core\Hi3Helper.Plugin.Core.csproj"/>
    <ProjectReference Include="..\SevenZipExtractor\SevenZipExtractor\SevenZipExtractor.csproj"/>
  </ItemGroup>

</Project>
