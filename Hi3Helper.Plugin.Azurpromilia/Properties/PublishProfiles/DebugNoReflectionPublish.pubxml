<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug Native AOT publish, reflection DISABLED (ReflectionFree).
  Invoke with:
      dotnet publish -c DebugNoReflection -r win-x64 -p:PublishProfile=DebugNoReflectionPublish
-->
<Project>
    <PropertyGroup>
        <Configuration>DebugNoReflection</Configuration>
        <Platform>x64</Platform>
        <PublishDir>publish/DebugNoReflection</PublishDir>
        <PublishProtocol>FileSystem</PublishProtocol>
        <_TargetId>Folder</_TargetId>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot>true</PublishAot>
        <DebugType>portable</DebugType>

        <!-- Compilation -->
        <Deterministic>true</Deterministic>
        <IlcDisableReflection>true</IlcDisableReflection>
    </PropertyGroup>
</Project>
