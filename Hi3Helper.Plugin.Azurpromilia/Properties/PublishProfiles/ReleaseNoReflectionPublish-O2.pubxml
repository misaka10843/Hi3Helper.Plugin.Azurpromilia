<?xml version="1.0" encoding="utf-8"?>
<!--
  Speed-preferred Native AOT publish, reflection DISABLED (ReflectionFree).
  Invoke with:
      dotnet publish -c ReleaseNoReflection -r win-x64 -p:PublishProfile=ReleaseNoReflectionPublish-O2

  NOTE: the upstream reference plugin's O2 profile mistakenly pins <Configuration>Release</Configuration>
  here, which makes the profile silently produce a reflection-enabled build. This one pins the
  matching ReleaseNoReflection configuration so the MANUALCOM / USELIGHTWEIGHTJSONPARSER defines
  actually apply.
-->
<Project>
    <PropertyGroup>
        <Configuration>ReleaseNoReflection</Configuration>
        <Platform>x64</Platform>
        <PublishDir>publish/ReleaseNoReflection</PublishDir>
        <PublishProtocol>FileSystem</PublishProtocol>
        <_TargetId>Folder</_TargetId>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot>true</PublishAot>
        <DebugType>portable</DebugType>

        <!-- Compilation and optimization -->
        <Optimize>true</Optimize>
        <Deterministic>true</Deterministic>
        <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
        <IlcDisableReflection>true</IlcDisableReflection>
        <OptimizationPreference>Speed</OptimizationPreference>
        <UseSizeOptimizedLinq>false</UseSizeOptimizedLinq>
        <IlcTrimMetadata>true</IlcTrimMetadata>
        <TrimMetadata>true</TrimMetadata>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <FoldIdenticalMethodBodies>true</FoldIdenticalMethodBodies>
        <IlcScanReflection>false</IlcScanReflection>
        <UseWindowsThreadPool>true</UseWindowsThreadPool>

        <!-- Diagnostics output -->
        <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
        <IlcGenerateDgmlFile>true</IlcGenerateDgmlFile>

        <!-- Security and resource management -->
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetricsSupport>false</MetricsSupport>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
        <InvariantGlobalization>true</InvariantGlobalization>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <StackTraceSupport>false</StackTraceSupport>
        <TrimmerRemoveAssemblies>true</TrimmerRemoveAssemblies>

        <!-- Runtime patch -->
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    </PropertyGroup>
</Project>
