<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug Native AOT publish (no optimization, reflection enabled, symbols kept).
  Invoke with:
      dotnet publish -c Debug -r win-x64 -p:PublishProfile=DebugPublish
-->
<Project>
    <PropertyGroup>
        <Configuration>Debug</Configuration>
        <Platform>x64</Platform>
        <PublishDir>publish/Debug</PublishDir>
        <PublishProtocol>FileSystem</PublishProtocol>
        <_TargetId>Folder</_TargetId>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot>true</PublishAot>
        <DebugType>portable</DebugType>

        <!-- Compilation -->
        <Deterministic>true</Deterministic>
        <IlcDisableReflection>false</IlcDisableReflection>
        <IlcScanReflection>false</IlcScanReflection>
    </PropertyGroup>
</Project>
