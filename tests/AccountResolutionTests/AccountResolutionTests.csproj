<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke test for AzurPromiliaAccount's credential-file resolution.

    It is a plain console app rather than an xunit project on purpose: this repository is built in
    environments where NuGet restore is unavailable (see ../Directory.Build.props), so it must not pull
    in a test framework. Run it with ./run-account-test.sh from the repository root.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>false</UseAppHost>
    <AssemblyName>AccountResolutionTests</AssemblyName>
    <RootNamespace>AccountResolutionTests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hi3Helper.Plugin.Azurpromilia\Hi3Helper.Plugin.Azurpromilia.csproj"/>
  </ItemGroup>

</Project>
